{ id:'a02', cat:'amd', page:16,
  q:'Ryzen 9000シリーズのコードネームは？',
  c:['Granite Ridge','Vermeer','Matisse','Raphael'], a:0,
  e:'Ryzen 7000=Raphael（Zen 4）、Ryzen 5000=Vermeer（Zen 3）、Ryzen 3000=Matisse（Zen 2）。' },
